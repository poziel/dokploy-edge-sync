# Base URL of the Dokploy API.
# Example: https://deploy.example.com/api
DOKPLOY_API_BASE=https://deploy.example.com/api

# Dokploy API token used to discover destinations, containers, and domains.
# This should be treated as a secret.
DOKPLOY_API_TOKEN=replace-me

# Path to the generated Traefik dynamic file on the ingress server
INGRESS_TRAEFIK_DYNAMIC_FILE=/etc/dokploy/traefik/dynamic/edge-sync.yml

# Reload Traefik only when the generated file changed
# true  = reload Traefik only when the generated file is updated
# false = always reload Traefik after a sync, even if the file content did not change
RELOAD_ON_CHANGE=true

# Name of the Traefik certificate resolver to use in generated routers.
# Example: letsencrypt, le, cloudflare
TRAEFIK_CERT_RESOLVER=letsencrypt

# Comma-separated list of Traefik entrypoints to assign to generated routers.
# Example: websecure
# Example: web,websecure
TRAEFIK_ENTRYPOINTS=websecure

# Path to the YAML file mapping Dokploy destination names to reachable IPs or hostnames.
SERVER_MAP_PATH=/app/config/servers.yml

# State file path
# A small JSON file is written after each successful sync containing metadata about the last generated config.
STATE_PATH=/app/data/last_generated.json

# Run the sync once when the container starts.
# true  = execute one sync at startup
# false = do not run automatically at startup
RUN_ON_STARTUP=true

# Enable the internal scheduler loop inside the container.
# true  = run sync repeatedly every SYNC_INTERVAL_SECONDS
# false = do not schedule internally
ENABLE_INTERNAL_SCHEDULER=false

# Interval in seconds for the internal scheduler.
# Only used when ENABLE_INTERNAL_SCHEDULER=true
SYNC_INTERVAL_SECONDS=300

# Keep the container alive after startup when the internal scheduler is disabled.
# This is useful for Dokploy scheduled tasks or manual execution.
# true  = stay alive after startup
# false = exit after startup work is done
IDLE_AFTER_START=true

# If true, containers with no explicit edge.enabled or traefik.enable labels
# may still be considered for exposure. Recommended to keep false.
EXPOSED_BY_DEFAULT=false

# If true, TLS certificate verification is skipped for Dokploy API requests.
# Recommended to keep false unless testing with self-signed certs.
SKIP_TLS_VERIFY=false

# Comma-separated list of allowed domain suffixes.
# Leave empty to allow all domains.
# Example: .example.com,.example.dev
ALLOWED_DOMAIN_SUFFIXES=.poziel.dev,.poziel.com,.poziel.gg,.poziel.tv

# Optional comma-separated list of domains to explicitly block.
DOMAIN_BLOCKLIST=

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Timeout in seconds for Dokploy API requests.
REQUEST_TIMEOUT_SECONDS=20

# Dry-run mode.
# true  = print generated config to logs instead of writing the output file
# false = write the output file normally
DRY_RUN=false